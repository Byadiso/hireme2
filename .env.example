AI_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Copy to .env (never commit it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
HIREMED_REQUIRE_AUTH=false
# Set true and use a strong password when deployed publicly.
HIREMED_DASHBOARD_PASSWORD=
# Required to share the uploaded structured profile across dashboard and GitHub Actions:
DATABASE_URL=
# SQLite fallback for local development only:
HIREMED_DB=data/hiremed.sqlite3
# Auto submission is OFF unless explicitly enabled for approved domains
HIREMED_AUTO_APPLY=
HIREMED_DAILY_LIMIT=3
APPLICANT_NAME=
APPLICANT_EMAIL=
RESUME_PATH=

# Optional second job source (remote English-oriented jobs, no API key):
JOB_SOURCES=adzuna,remotive
